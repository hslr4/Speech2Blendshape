# Dockerfile for Nvidia Jetson Devices
FROM dustynv/pytorch:2.7-r36.4.0


RUN apt-get update && apt-get upgrade -y && \
 apt-get install -y --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/*

RUN pip3 install --upgrade --index-url https://pypi.jetson-ai-lab.io/jp6/cu122 pip && \
  pip3 install --no-cache-dir --index-url https://pypi.jetson-ai-lab.io/jp6/cu122 transformers==4.57.0 librosa==0.11.0 uvicorn==0.37.0 fastapi==0.119.0

COPY . /root/Speech2Blendshape
WORKDIR /root/Speech2Blendshape

CMD python3 server.py